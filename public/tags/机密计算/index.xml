&lt;li&gt;&lt;a href=&#34;#%E4%B8%80%E3%80%81%E6%8A%80%E6%9C%AF%E8%B0%83%E7%A0%94&#34;&gt;一、技术调研&lt;/a&gt;&lt;/li&gt;
&lt;li&gt;&lt;a href=&#34;#%E4%BA%8C%E3%80%81%E6%96%B9%E6%A1%88%E5%AF%B9%E6%AF%94&#34;&gt;二、方案对比&lt;/a&gt;&lt;/li&gt;
&lt;/ol&gt;
