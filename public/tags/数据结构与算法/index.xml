&lt;li&gt;&lt;a href=&#34;#2-4-%E7%A7%BB%E9%99%A4%E6%95%B0%E7%BB%84%E6%95%B0%E9%87%8F%E5%A4%A7%E4%BA%8E2%E7%9A%84%E5%85%83%E7%B4%A0&#34;&gt;2.4 移除数组数量大于2的元素&lt;/a&gt;&lt;/li&gt;
